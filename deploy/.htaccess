DirectoryIndex index.html index.php
Options -Indexes

ErrorDocument 404 /404.html

RewriteEngine On

# Keep PHP API working
RewriteRule ^api/ - [L]

# Retired service → diagnostics (permanent)
RewriteRule ^services/obsluzhivanie-kotelnyh/?$ /services/diagnostika-i-obsledovanie/ [R=301,L]

# Former about page merged into homepage (permanent)
RewriteRule ^about/?$ / [R=301,L]
RewriteRule ^about/index\.html$ / [R=301,L]

# Map clean URLs to exported .html when trailingSlash is false (safety)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
