# Optional local/dev note only. On Apache shared hosting the runtime
# webhook is read by PHP from OUTSIDE DocumentRoot:
#   ~/teploenergokomplekt/leads.env  (preferred)
#   ~/teploenergokomplekt/.env       (legacy)
# Never put the real webhook in NEXT_PUBLIC_* or under www/.
# LEADS_WEBHOOK_URL=

# Public site URL for canonical / sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.com
